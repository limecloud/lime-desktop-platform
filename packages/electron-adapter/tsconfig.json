{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "rootDir": "../..",
    "verbatimModuleSyntax": true,
    "types": ["node", "electron"],
    "paths": {
      "@limecloud/desktop-platform-contracts": ["../contracts/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../src/main/services/**/*.ts",
    "../../src/shared/types.ts"
  ]
}
